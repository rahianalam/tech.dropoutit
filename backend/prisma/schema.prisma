// Tech.Dropout data model. Money is stored in paisa (BDT * 100) as integers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & roles ----------

enum Role {
  ADMIN
  TEACHER
  STUDENT
  EMPLOYER
  JOB_SEEKER
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  /// The person deleted their account; personal data is wiped, money records stay.
  DELETED
}

model User {
  id              String     @id @default(uuid())
  name            String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  roles           UserRole[]
  /// Code friends sign up with; referrals that buy a paid course earn this user free course time
  referralCode    String?    @unique
  referredById    String?
  /// Any paid course is free to start until this time (referral reward)
  freePassUntil   DateTime?
  /// How many referral rewards were already given (one per `referralTarget` qualified friends)
  referralRewards Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  teacherApplications  TeacherApplication[] @relation("applicant")
  reviewedApplications TeacherApplication[] @relation("reviewer")
  teacherProfile       TeacherProfile?
  portfolioItems       PortfolioItem[]
  courses              Course[]
  enrollments          Enrollment[]
  reviews              Review[]
  orders               Order[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  availabilityRules    AvailabilityRule[]
  teacherBookings      Booking[]            @relation("bookingTeacher")
  studentBookings      Booking[]            @relation("bookingStudent")
  employerProfile      EmployerProfile?
  seekerProfile        SeekerProfile?
  jobApplications      JobApplication[]
  uploads              Upload[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  deviceTokens         DeviceToken[]
  referredBy           User?                @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]               @relation("referrals")
  affiliateProfile     AffiliateProfile?
}

model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Teachers ----------

enum ApplicationStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model TeacherApplication {
  id              String            @id @default(uuid())
  userId          String
  headline        String
  bio             String
  skills          String[]
  experience      String
  demoVideoUrl    String?
  status          ApplicationStatus @default(PENDING)
  /// When the applicant accepted the instructor rules (fees, free-first courses, storage)
  rulesAcceptedAt DateTime?
  adminNote       String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("reviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

enum PortfolioType {
  IMAGE
  VIDEO
  LINK
  CERTIFICATE
  CV
}

model PortfolioItem {
  id        String        @id @default(uuid())
  ownerId   String
  type      PortfolioType
  title     String
  url       String
  createdAt DateTime      @default(now())
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  userId               String      @id
  headline             String
  bio                  String
  skills               String[]
  courseCommissionBps  Int? // per-teacher override, basis points (3000 = 30%)
  sessionCommissionBps Int?
  payoutMethod         String?
  payoutAccount        String?
  experience           String?
  expertise            String[]    @default([])
  /// 1:1 price per hour; a slot costs rate x minutes / 60 (0 = free intro slots only)
  hourlyRatePaisa      Int?
  /// Blue tick: reached the free-course, views and watch-time targets (or granted by the admin)
  verifiedAt           DateTime?
  /// New instructors start with free courses only; true once verified (existing instructors keep paid courses)
  canSellPaid          Boolean     @default(false)
  storagePlan          StoragePlan @default(FREE)
  storagePlanUntil     DateTime?
  rulesAcceptedAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Learning ----------

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  /// Material icon name shown in the app (e.g. "code", "brush"); the app falls back to a generic icon.
  icon     String?
  /// Hex colour for the category chip, e.g. "#355457".
  color    String?
  position Int        @default(0)
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")
  courses  Course[]
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL
}

model Course {
  id                 String       @id @default(uuid())
  teacherId          String
  /// Lesson plays by learners (not the instructor); counts toward the blue tick
  views              Int          @default(0)
  categoryId         String?
  title              String
  subtitle           String?
  description        String
  thumbnailUrl       String?
  pricePaisa         Int          @default(0)
  /// Optional "was" price shown struck through next to the real price.
  originalPricePaisa Int?
  isFree             Boolean      @default(true)
  /// "What you'll learn" bullet points.
  outcomes           String[]     @default([])
  /// "Requirements" bullet points.
  requirements       String[]     @default([])
  /// "Who this course is for" bullet points.
  audience           String[]     @default([])
  level              CourseLevel  @default(ALL)
  language           String       @default("bn")
  status             CourseStatus @default(DRAFT)
  adminNote          String?
  isFeatured         Boolean      @default(false)
  ratingAvg          Float        @default(0)
  ratingCount        Int          @default(0)
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  teacher            User         @relation(fields: [teacherId], references: [id])
  category           Category?    @relation(fields: [categoryId], references: [id])
  sections           Section[]
  enrollments        Enrollment[]
  reviews            Review[]

  @@index([status])
  @@index([teacherId])
}

model Section {
  id       String   @id @default(uuid())
  courseId String
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

enum LessonType {
  VIDEO
  PDF
  QUIZ
  TEXT
}

model Lesson {
  id          String           @id @default(uuid())
  sectionId   String
  title       String
  type        LessonType       @default(VIDEO)
  mediaKey    String? // storage key; never exposed directly, served via signed URL
  content     String?
  durationSec Int              @default(0)
  isPreview   Boolean          @default(false)
  position    Int
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
}

enum EnrollmentStatus {
  ACTIVE
  REFUNDED
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  orderId     String?          @unique
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Int              @default(0)
  completedAt DateTime?
  /// Set for enrollments made with a referral free pass: access ends then
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
  course      Course           @relation(fields: [courseId], references: [id])
  order       Order?           @relation(fields: [orderId], references: [id])
  progress    LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  enrollmentId String
  lessonId     String
  watchedSec   Int        @default(0)
  completed    Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  courseId  String?
  bookingId String?  @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  course    Course?  @relation(fields: [courseId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id])

  @@unique([userId, courseId])
}

// ---------- Money (phase 2) ----------

enum OrderItemType {
  COURSE
  BOOKING
  JOB_POST
  STORAGE_PLAN
  AFFILIATE_MEMBERSHIP
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  itemType      OrderItemType
  itemId        String
  amountPaisa   Int
  discountPaisa Int           @default(0)
  status        OrderStatus   @default(PENDING)
  tranId        String        @unique
  paidAt        DateTime?
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Affiliate whose link brought this sale
  affiliateId   String?
  user          User          @relation(fields: [userId], references: [id])
  payments      Payment[]
  enrollment    Enrollment?
  booking       Booking?
  ledgerEntries LedgerEntry[]

  @@index([status, createdAt])
}

model Payment {
  id          String    @id @default(uuid())
  orderId     String
  gateway     String
  gatewayRef  String?
  amountPaisa Int
  feePaisa    Int       @default(0)
  rawPayload  Json?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id])
}

enum LedgerType {
  EARNING
  REFUND
  PAYOUT
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  PAID
  VOID
}

model LedgerEntry {
  id              String       @id @default(uuid())
  teacherId       String
  orderId         String?
  payoutId        String?
  type            LedgerType
  amountPaisa     Int
  commissionBps   Int          @default(0)
  /// Fee breakdown shown to the instructor: gross - commission - VAT = amountPaisa
  grossPaisa      Int          @default(0)
  commissionPaisa Int          @default(0)
  vatPaisa        Int          @default(0)
  status          LedgerStatus @default(PENDING)
  availableAt     DateTime?
  createdAt       DateTime     @default(now())
  teacher         User         @relation(fields: [teacherId], references: [id])
  order           Order?       @relation(fields: [orderId], references: [id])
  payout          Payout?      @relation(fields: [payoutId], references: [id])

  @@index([teacherId, status])
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
}

model Payout {
  id          String        @id @default(uuid())
  teacherId   String
  amountPaisa Int
  method      String?
  account     String?
  status      PayoutStatus  @default(DRAFT)
  reference   String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  teacher     User          @relation(fields: [teacherId], references: [id])
  entries     LedgerEntry[]
}

enum PayoutSchedule {
  WEEKLY
  MONTHLY
  MANUAL
}

// Singleton row (id = 1). Every value is editable from the admin panel.
enum StoragePlan {
  FREE
  STARTER
  PRO
  UNLIMITED
}

model PlatformSettings {
  id                        Int            @id @default(1)
  /// Platform fee on a recorded course sale for a regular instructor (700 = 7%)
  courseCommissionBps       Int            @default(700)
  silverCourseCommissionBps Int            @default(600)
  goldCourseCommissionBps   Int            @default(500)
  /// Platform fee on a 1:1 booking (1000 = 10%)
  sessionCommissionBps      Int            @default(1000)
  /// VAT taken from every sale and booking (500 = 5%)
  vatBps                    Int            @default(500)
  silverSales               Int            @default(25)
  goldSales                 Int            @default(50)
  /// Hours an instructor has to accept a booking request before it is declined and refunded
  bookingResponseHours      Int            @default(24)
  freeCoursesRequired       Int            @default(10)
  viewsRequired             Int            @default(4000)
  watchMinutesRequired      Int            @default(10000)
  freeVideoLimit            Int            @default(10)
  starterVideoLimit         Int            @default(50)
  proVideoLimit             Int            @default(200)
  starterPricePaisa         Int            @default(19900)
  proPricePaisa             Int            @default(49900)
  unlimitedPricePaisa       Int            @default(99900)
  referralTarget            Int            @default(15)
  referralPassDays          Int            @default(15)
  affiliateCommissionBps    Int            @default(200)
  /// $5 membership in taka
  affiliateFeePaisa         Int            @default(60000)
  affiliateInactiveDays     Int            @default(180)
  holdDays                  Int            @default(7)
  payoutSchedule            PayoutSchedule @default(MONTHLY)
  payoutDayOfMonth          Int            @default(1)
  minPayoutPaisa            Int            @default(100000)
  updatedAt                 DateTime       @updatedAt
}

// ---------- Bookings (phase 3) ----------

model AvailabilityRule {
  id          String @id @default(uuid())
  teacherId   String
  weekday     Int // 0 = Sunday
  startMinute Int // minutes from 00:00 in teacher timezone
  endMinute   Int
  slotMinutes Int    @default(60)
  pricePaisa  Int
  timezone    String @default("Asia/Dhaka")
  teacher     User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  HELD
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id          String        @id @default(uuid())
  teacherId   String
  studentId   String
  startAt     DateTime
  endAt       DateTime
  orderId     String?       @unique
  status      BookingStatus @default(HELD)
  heldUntil   DateTime?
  meetingUrl  String?
  pricePaisa  Int           @default(0)
  /// Instructor must accept or decline before this time, otherwise it is declined and refunded
  respondBy   DateTime?
  declineNote String?
  reminded24  Boolean       @default(false)
  reminded15  Boolean       @default(false)
  cancelledBy String?
  // 'live' while HELD/CONFIRMED/COMPLETED, NULL once cancelled or no-show.
  // Postgres treats NULLs as distinct, so the unique key below allows only
  // one live booking per teacher slot while keeping cancelled history.
  slotLock    String?       @default("live")
  createdAt   DateTime      @default(now())
  teacher     User          @relation("bookingTeacher", fields: [teacherId], references: [id])
  student     User          @relation("bookingStudent", fields: [studentId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
  review      Review?

  @@unique([teacherId, startAt, slotLock])
  @@index([studentId])
}

// ---------- Jobs (phase 4) ----------

model EmployerProfile {
  userId      String   @id
  companyName String
  logoUrl     String?
  website     String?
  about       String?
  location    String?
  /// Verified employers' jobs go live without admin review.
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]
}

model SeekerProfile {
  userId     String   @id
  headline   String
  about      String?
  skills     String[]
  location   String?
  /// Uploaded CV (PDF) or, failing that, a link to one.
  cvUploadId String?
  cvLink     String?
  openToWork Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvUpload   Upload?  @relation(fields: [cvUploadId], references: [id], onDelete: SetNull)
}

enum UploadKind {
  CV
  LOGO
  /// Course thumbnails and avatars: served from a permanent public link.
  IMAGE
  /// Recorded lesson videos: served from signed, expiring links with HTTP Range support.
  VIDEO
  /// Identity documents (NID, photo, selfie) for affiliate verification: admin-only
  KYC
}

/// A file kept on the server's disk (UPLOAD_DIR). Served only through signed, expiring links.
model Upload {
  id           String           @id @default(uuid())
  ownerId      String
  kind         UploadKind
  mime         String
  size         Int
  originalName String
  /// Where the bytes live in the active storage driver (local disk, Firebase, S3...). Null = the upload id.
  storageKey   String?
  createdAt    DateTime         @default(now())
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  seekers      SeekerProfile[]
  applications JobApplication[]
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  PENDING
  LIVE
  CLOSED
  REJECTED
}

model Job {
  id           String           @id @default(uuid())
  employerId   String
  title        String
  description  String
  skills       String[]
  type         JobType
  location     String?
  salaryMin    Int?
  salaryMax    Int?
  deadline     DateTime?
  status       JobStatus        @default(PENDING)
  rejectReason String?
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  employer     EmployerProfile  @relation(fields: [employerId], references: [userId])
  applications JobApplication[]

  @@index([status, publishedAt])
}

enum ApplicationStage {
  APPLIED
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

model JobApplication {
  id          String           @id @default(uuid())
  jobId       String
  seekerId    String
  /// CV as it was when they applied, so later profile edits don't change past applications.
  cvUploadId  String?
  cvLink      String?
  coverLetter String?
  stage       ApplicationStage @default(APPLIED)
  /// Employer's private note.
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  job         Job              @relation(fields: [jobId], references: [id])
  seeker      User             @relation(fields: [seekerId], references: [id])
  cvUpload    Upload?          @relation(fields: [cvUploadId], references: [id], onDelete: SetNull)

  @@unique([jobId, seekerId])
  @@index([seekerId])
}

// ---------- Misc ----------

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  /// Set once the push has been sent (or there was no device to send to).
  pushedAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pushedAt, createdAt])
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// A phone that receives push notifications (Firebase Cloud Messaging token).
model DeviceToken {
  token      String         @id
  userId     String
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  target    String
  meta      Json?
  createdAt DateTime @default(now())
}

// ---------- Affiliates ----------

enum AffiliateStatus {
  /// Signed up; the membership fee is not paid yet
  UNPAID
  /// Paid; documents waiting for the admin
  IN_REVIEW
  ACTIVE
  REJECTED
  /// No sale or click for `affiliateInactiveDays`
  DEACTIVATED
}

model AffiliateProfile {
  userId           String             @id
  code             String             @unique
  status           AffiliateStatus    @default(UNPAID)
  nidNumber        String?
  nidFrontId       String?
  nidBackId        String?
  photoId          String?
  selfieId         String?
  adminNote        String?
  membershipPaidAt DateTime?
  lastActiveAt     DateTime           @default(now())
  payoutMethod     String?
  payoutAccount    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks           AffiliateClick[]
  earnings         AffiliateEarning[]
}

model AffiliateClick {
  id          String           @id @default(uuid())
  affiliateId String
  courseId    String?
  createdAt   DateTime         @default(now())
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [userId], onDelete: Cascade)

  @@index([affiliateId, createdAt])
}

model AffiliateEarning {
  id          String           @id @default(uuid())
  affiliateId String
  orderId     String           @unique
  courseId    String
  amountPaisa Int
  status      LedgerStatus     @default(PENDING)
  availableAt DateTime
  createdAt   DateTime         @default(now())
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [userId], onDelete: Cascade)

  @@index([affiliateId, status])
}
