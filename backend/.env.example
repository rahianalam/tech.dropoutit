DATABASE_URL=postgresql://techdropout:techdropout@localhost:5432/techdropout
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=3000
# First admin, created by `npm run seed`
ADMIN_EMAIL=admin@tech.dropout.it
ADMIN_PASSWORD=change-me
# Public URL of this API (used in payment callbacks)
PUBLIC_API_URL=http://localhost:3000/api/v1
# sslcommerz (default) or fake (local testing)
PAYMENT_GATEWAY=sslcommerz
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
# Optional: link shown after payment
APP_RETURN_URL=
MEDIA_BASE_URL=https://media.tech.dropout.it
MEDIA_SIGNING_KEY=change-me

# Video calls for 1:1 sessions (Jitsi or self-hosted Jitsi)
MEETING_BASE_URL=https://meet.jit.si

# Where uploaded CVs are stored (a Docker volume in production) and the key for their signed links
UPLOAD_DIR=./uploads
FILE_SIGNING_KEY=change-me
